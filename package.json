{
  "name": "@local/dsh-chat-space",
  "version": "1.0.63",
  "private": true,
  "type": "module",
  "description": "Mica Space: ask multiple follow-ups from one answer without scrolling through a long chat. A zoomable branching conversation canvas for DSH with local zero-config memory.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "PRIVACY.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "locale/*.json",
    "icon.svg",
    "copy/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "plugin",
    "chat",
    "canvas",
    "branching",
    "rag"
  ],
  "scripts": {
    "test": "node --test tests/context.test.mjs tests/library.test.mjs tests/embedding.test.mjs tests/semantic.test.mjs tests/parent-child.test.mjs tests/rag-eval.test.mjs tests/performance.test.mjs tests/ui-smoke.test.cjs"
  },
  "homepage": "https://github.com/ToiMee/mica_space",
  "author": {
    "name": "ToiMee",
    "url": "https://github.com/ToiMee"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ToiMee/mica_space.git"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1"
  }
}
